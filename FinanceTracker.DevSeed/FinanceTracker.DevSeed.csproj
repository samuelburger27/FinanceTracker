<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>FinanceTracker.DevSeed</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The main MAUI project's DbContext file lives under FinanceTracker/Services/Database
             and refers to Microsoft.Maui.Storage.FileSystem. We link only what we need here
             and provide our own DbContext. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.6" />
        <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- Share model classes with the main MAUI project to stay schema-compatible. -->
        <Compile Include="..\FinanceTracker\Models\User.cs" Link="Shared\Models\User.cs" />
        <Compile Include="..\FinanceTracker\Models\Category.cs" Link="Shared\Models\Category.cs" />
        <Compile Include="..\FinanceTracker\Models\Transaction.cs" Link="Shared\Models\Transaction.cs" />
        <Compile Include="..\FinanceTracker\Models\TransactionType.cs" Link="Shared\Models\TransactionType.cs" />
        <Compile Include="..\FinanceTracker\Services\Database\AppDbContext.cs" Link="Shared\Services\Database\AppDbContext.cs" />
    </ItemGroup>

</Project>
