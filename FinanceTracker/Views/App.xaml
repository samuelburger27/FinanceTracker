<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:FinanceTracker.Converters"
             x:Class="FinanceTracker.Views.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:TransactionTypeToColorConverter x:Key="TransactionTypeToColorConverter" />
            <converters:TransactionTypeToSignConverter x:Key="TransactionTypeToSignConverter" />
            <converters:TransactionTypeToSoftColorConverter x:Key="TransactionTypeToSoftColorConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:CategoryToIconConverter x:Key="CategoryToIconConverter" />
            <converters:BoolToSurfaceColorConverter x:Key="BoolToSurfaceColorConverter" />
            <converters:BoolToPrimaryTextColorConverter x:Key="BoolToPrimaryTextColorConverter" />
            <converters:BoolToSuccessDangerColorConverter x:Key="BoolToSuccessDangerColorConverter" />
            <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
